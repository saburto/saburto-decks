{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "verbatimModuleSyntax": true
  },
  "include": ["src", "decks", "test", "e2e", "scripts", "vite.config.ts", "playwright.config.ts", "src/mdx.d.ts"]
}
