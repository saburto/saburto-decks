{
  "name": "@saburto/saburto-decks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "demo": "bun run build && bun run scripts/serve.ts",
    "test": "bun test --path-ignore-patterns='e2e/**'",
