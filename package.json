{
  "name": "@saburto/saburto-decks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./mdx": "./dist/mdx.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:lib && bun run build:demo && bun run build:react",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:demo": "astro build --root demo",
    "build:react": "vite build --config react-demo/vite.config.ts",
    "dev": "astro dev --root demo --port 4173",
    "dev:react": "vite --config react-demo/vite.config.ts",
    "preview": "astro preview --root demo --port 4173",
    "preview:react": "vite preview --config react-demo/vite.config.ts",
    "demo": "bun run build && bun run preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test --path-ignore-patterns='e2e/**'",
    "test:e2e": "playwright test",
    "inspect": "bun run scripts/inspect.ts",
    "compile": "bun run scripts/compile.ts",
    "verify": "bun run typecheck && bun run test && bun run build && bun run test:e2e",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "4.4.3",
    "mermaid": "^12.0.0",
    "motion": "13.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "rough-notation": "^0.5.1",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.5",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "astro": "^7.3.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
