    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "1.61.1",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "typescript": "^5.9.3",
    "unist-util-mdx-define": "^1.1.2",
    "vite": "^8.3.0"
  }
}
